<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>BraviaTheatre.UI</RootNamespace>
    <AssemblyName>BraviaTheatrePC</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The release is one executable, so its native libraries travel inside it and the
         host extracts them to %TEMP%\.net on start. BundledNativeLibraries keeps them
         loaded so temp cleanup cannot delete them under the running app, and
         BundleExtractionCleanup removes the folders earlier builds left there. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Compressing the bundle forces every managed assembly to be decompressed into
         private memory on load. Left uncompressed they are mapped straight from the
         file, so the pages stay shared, file-backed, and reclaimable: measured 89 MB
         to 23 MB private working set. The release ships the executable in a zip, so
         the download stays the same size. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- With these the publish folder holds only the executable. The SDK already bundles
         the WebView2 loader (and copies it under runtimes\ for a development build); the
         package's own copy landed beside the executable as a stray duplicate. -->
    <WebView2NeverCopyLoaderDllToOutputDirectory>true</WebView2NeverCopyLoaderDllToOutputDirectory>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- LibraryImport generates its marshalling code, which needs unsafe blocks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Native Windows 11 Fluent audio controller for Sony BRAVIA Theatre systems</Description>
  </PropertyGroup>

  <!-- Framework-dependent publishes skip ReadyToRun. The SDK compiles a self-contained single file
       into one composite image and keeps the result in obj\...\R2R, which a framework-dependent
       publish for the same runtime shares. Its incremental compile then reused those stubs, whose
       code lives in the composite image only the self-contained bundle carries, and the runtime
       failed fast before Main (0xC0000602): that download never started. The condition is an
       explicit false so that a restore naming neither variant, like the release's, still fetches
       the compiler for the self-contained publish (otherwise NETSDK1094). -->
  <PropertyGroup Condition="'$(SelfContained)' == 'false'">
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BraviaTheatre.Core\BraviaTheatre.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="..\..\assets\icons\*.png"
              Link="Assets\Icons\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BraviaTheatre.Tests" />
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Appearance.DisableFluentThemeWindowBackdrop"
                                    Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

</Project>
