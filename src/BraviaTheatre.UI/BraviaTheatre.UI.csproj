<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>BraviaTheatre.UI</RootNamespace>
    <AssemblyName>BraviaTheatrePC</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Compressing the bundle forces every managed assembly to be decompressed into
         private memory on load. Left uncompressed they are mapped straight from the
         file, so the pages stay shared, file-backed, and reclaimable: measured 89 MB
         to 23 MB private working set. The release ships the executable in a zip, so
         the download stays the same size. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <Description>Native Windows 11 Fluent audio controller for Sony BRAVIA Theatre systems</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BraviaTheatre.Core\BraviaTheatre.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="..\..\assets\icons\*.png"
              Link="Assets\Icons\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BraviaTheatre.Tests" />
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Appearance.DisableFluentThemeWindowBackdrop"
                                    Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

</Project>
