<Window x:Class="BraviaTheatre.UI.Views.DeviceSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Sony device — BRAVIA Theatre PC"
        ThemeMode="System"
        Width="440"
        Height="380"
        MinWidth="380"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="Transparent"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Border Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Select a Sony device" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="More than one compatible device is linked to this account."
                           Style="{StaticResource CaptionText}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <ListBox x:Name="DeviceList"
                     Grid.Row="1"
                     AutomationProperties.Name="Sony devices"
                     MouseDoubleClick="DeviceList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8,6">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DeviceType}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" IsCancel="True" MinWidth="88" Height="34" Margin="0,0,8,0"/>
                <Button Content="Continue"
                        IsDefault="True"
                        MinWidth="96"
                        Height="34"
                        Style="{StaticResource AccentButton}"
                        Click="Continue_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
