<Window x:Class="BraviaTheatre.UI.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BRAVIA Theatre PC"
        Width="350"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Windows 11 Fluent Sound Slider Style matching native quick settings -->
        <Style x:Key="FluentSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="22">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="4.5" CornerRadius="2.25,0,0,2.25" Background="#4CC2FF"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="4.5" CornerRadius="0,2.25,2.25,0" Background="#8A8A8A"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="22" Height="22">
                                                    <!-- Outer Translucent Dark Halo -->
                                                    <Ellipse x:Name="OuterHalo" Width="20" Height="20" Fill="#444444" Opacity="0.85"/>
                                                    <!-- Inner Solid Fluent Blue Core -->
                                                    <Ellipse x:Name="InnerCore" Width="12" Height="12" Fill="#4CC2FF"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="OuterHalo" Property="Fill" Value="#555555"/>
                                                        <Setter TargetName="InnerCore" Property="Fill" Value="#6CD4FF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="OuterHalo" Property="Fill" Value="#333333"/>
                                                        <Setter TargetName="InnerCore" Property="Fill" Value="#38AEE6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segment Button Style -->
        <Style x:Key="SegmentBtn" TargetType="Button">
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="segBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="6,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="segBorder" Property="Background" Value="#2E2E2E"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat Icon Button Style -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="iconBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="iconBorder" Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="iconBorder" Property="Background" Value="#222222"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header Input Button Style -->
        <Style x:Key="HeaderInputBtn" TargetType="Button">
            <Setter Property="Background" Value="#2C2C2C"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="hb" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="8,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hb" Property="Background" Value="#383838"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Action Tile Button Style -->
        <Style x:Key="ActionTile" TargetType="Button">
            <Setter Property="Height" Value="60"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="6,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#343434"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#484848"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#222222"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container with Windows 11 Rounded Drop Shadow Frame & Acrylic Blur -->
    <Border x:Name="RootBorder" CornerRadius="12" Background="#E61E1E1E" BorderBrush="#383838" BorderThickness="1" Margin="10">
        <Border.RenderTransform>
            <TranslateTransform x:Name="FlyoutTransform" Y="0"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <!-- Row 0: Top Header -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Hero Codec Card -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: 1x3 Quick Action Tiles (Night mode, Sound field, Voice mode) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 3: Volume, Bass & Optional Rear Section (at bottom for ergonomic fast reach) -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header (Title, Input Selector, Glowing Power Button, Settings Gear) -->
            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock x:Name="TxtDeviceName" Text="BRAVIA Theatre Bar 9" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Input Source Dropdown Button -->
                    <Button x:Name="BtnInputSource" Content="HDMI ▾" Style="{StaticResource HeaderInputBtn}" Margin="0,0,8,0" Click="BtnInputSource_Click"/>

                    <!-- Header Power Button (Glowing Green when On, Grey when Standby) -->
                    <Button x:Name="BtnHeaderPower" Width="26" Height="26" Margin="0,0,6,0" Style="{StaticResource IconButton}" ToolTip="Power: Online (Click to Toggle)" Click="BtnPower_Click">
                        <Path x:Name="IconPower" Stretch="Uniform" Width="14" Height="14" Fill="#44D644"
                              Data="M11,2h2v10h-2z M12.5,4.05c3.84,0.31,6.97,3.44,7.28,7.28c0.39,4.86-3.44,8.96-8.28,8.96c-4.42,0-8-3.58-8-8c0-3.66,2.46-6.75,5.85-7.7L9.9,6.5c-2.34,0.73-4.05,2.91-4.05,5.5c0,3.31,2.69,6,6,6s6-2.69,6-6c0-2.59-1.71-4.77-4.05-5.5L12.5,4.05z">
                            <Path.Effect>
                                <DropShadowEffect x:Name="PowerShadow" BlurRadius="6" ShadowDepth="0" Color="#44D644" Opacity="0.8"/>
                            </Path.Effect>
                        </Path>
                    </Button>

                    <!-- Settings Gear Button -->
                    <Button x:Name="BtnSettings" Width="22" Height="22" Style="{StaticResource IconButton}" ToolTip="Settings" Click="BtnSettings_Click">
                        <TextBlock Text="⚙" Foreground="#888888" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Row 1: Hero Codec Card -->
            <Border Grid.Row="1" Background="#262626" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image x:Name="ImgCodecBadge" Width="54" Height="54" Stretch="Uniform" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="TxtCodecName" Text="Dolby Atmos" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border x:Name="BadgeChannel" Background="#383838" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock x:Name="TxtChannel" Text="7.1 ch" Foreground="#D0D0D0" FontSize="11" FontWeight="Medium"/>
                            </Border>
                            <Border Background="#2F2F2F" CornerRadius="4" Padding="6,2">
                                <TextBlock x:Name="TxtInput" Text="eARC / HDMI" Foreground="#A0A0A0" FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 2: 1x3 Quick Action Tiles Grid (Night Mode | Sound Field | Voice Mode) matching Sony App -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 1. Night Mode -->
                <Button x:Name="BtnNightMode" Grid.Column="0" Style="{StaticResource ActionTile}" Margin="0,0,4,0" Click="BtnNightMode_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Night Mode" FontWeight="SemiBold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtNightModeStatus" Text="Off" FontSize="11" Foreground="#888888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- 2. Sound Field -->
                <Button x:Name="BtnSoundField" Grid.Column="1" Style="{StaticResource ActionTile}" Margin="2,0,2,0" Click="BtnSoundField_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Sound Field" FontWeight="SemiBold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtSoundFieldStatus" Text="On" FontSize="11" Foreground="#4CC2FF" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- 3. Voice Mode -->
                <Button x:Name="BtnVoiceMode" Grid.Column="2" Style="{StaticResource ActionTile}" Margin="4,0,0,0" Click="BtnVoiceMode_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Voice Mode" FontWeight="SemiBold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtVoiceModeStatus" Text="Off" FontSize="11" Foreground="#888888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Row 3: Volume, Bass & Optional Rear Section (Ergonomic Fast Reach at Bottom) -->
            <Border Grid.Row="3" Background="#262626" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="12,10" MouseWheel="BorderVolume_MouseWheel">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Volume Title & Value Badge -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="Volume" Foreground="#D0D0D0" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                        <Border Background="#333333" CornerRadius="6" Padding="8,2" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtVolumeValue" Text="61" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                        </Border>
                    </DockPanel>

                    <!-- Row 1: Speaker / Mute Icon + Windows 11 Slider -->
                    <Grid Grid.Row="1" Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Speaker / Mute Icon Button with Windows Icon Geometry -->
                        <Button x:Name="BtnSliderMute" Grid.Column="0" Width="26" Height="26" Margin="0,0,8,0" Style="{StaticResource IconButton}" Click="BtnSliderMute_Click">
                            <Path x:Name="IconSpeaker" Stretch="Uniform" Width="14" Height="14" Fill="#D0D0D0"
                                  Data="M2,8v8h4l6,5V3L6,8H2z M16.5,8c.9,1.1 1.5,2.5 1.5,4s-.6,2.9-1.5,4l-1.5-1.5c.6-.7 1-1.6 1-2.5s-.4-1.8-1-2.5L16.5,8z M19,5.5c1.9,1.7 3,4 3,6.5s-1.1,4.8-3,6.5l-1.5-1.5c1.5-1.3 2.5-3.1 2.5-5s-1-3.7-2.5-5L19,5.5z"/>
                        </Button>

                        <Slider x:Name="SliderVolume" Grid.Column="1" Style="{StaticResource FluentSlider}" Value="61" ValueChanged="SliderVolume_ValueChanged"/>
                    </Grid>

                    <!-- Row 2: Compact Bass Level Selector -->
                    <DockPanel Grid.Row="2" Margin="0,2,0,0">
                        <TextBlock Text="Bass Level" Foreground="#888888" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                        <Border Background="#1C1C1C" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" Padding="2" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnBassMin" Content="MIN" Style="{StaticResource SegmentBtn}" Click="BtnBassMin_Click"/>
                                <Button x:Name="BtnBassMid" Content="MID" Style="{StaticResource SegmentBtn}" Click="BtnBassMid_Click"/>
                                <Button x:Name="BtnBassMax" Content="MAX" Style="{StaticResource SegmentBtn}" Click="BtnBassMax_Click"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <!-- Row 3: Optional Rear Speaker Level Slider (-10 to +10) -->
                    <Grid x:Name="PanelRearSpeaker" Grid.Row="3" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="Rear Speakers Level" Foreground="#888888" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                            <Border Background="#1C1C1C" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                <TextBlock x:Name="TxtRearValue" Text="0" Foreground="#4CC2FF" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </DockPanel>

                        <Slider x:Name="SliderRear" Grid.Row="1" Minimum="-10" Maximum="10" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1" Style="{StaticResource FluentSlider}" Value="0" ValueChanged="SliderRear_ValueChanged"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
