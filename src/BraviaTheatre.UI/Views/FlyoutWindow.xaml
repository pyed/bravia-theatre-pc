<Window x:Class="BraviaTheatre.UI.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:BraviaTheatre.Core.Models;assembly=BraviaTheatre.Core"
        Title="BRAVIA Theatre PC"
        ThemeMode="System"
        Width="384"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style x:Key="HeaderInputButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ActionTile" TargetType="ToggleButton">
            <Setter Property="Height" Value="76"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="TileBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorOnAccentDefaultBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsPressed" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}"/>
                                <Setter TargetName="TileBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}"/>
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SegmentBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="True"/>
                                    <Condition Property="IsPressed" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}"/>
                                <Setter TargetName="SegmentBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The root fills the HWND exactly. DWM supplies the native rounded clipping,
         desktop acrylic, and shadow, avoiding the old rectangular outer frame. -->
    <Border x:Name="RootBorder"
            Background="Transparent"
            BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <ScrollViewer x:Name="MainScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtDeviceName"
                               Text="BRAVIA Theatre"
                               FontWeight="SemiBold"
                               FontSize="18"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="2,0,12,0"/>

                    <Button x:Name="BtnInputSource"
                            Grid.Column="1"
                            Style="{StaticResource HeaderInputButton}"
                            Margin="0,0,8,0"
                            Click="BtnInputSource_Click"
                            AutomationProperties.Name="Input source">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtHeaderInput" Text="HDMI" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="10" Margin="8,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnHeaderPower"
                            Grid.Column="2"
                            Style="{StaticResource IconButton}"
                            ToolTip="Soundbar power"
                            Click="BtnPower_Click"
                            AutomationProperties.Name="Soundbar power">
                        <Path x:Name="IconPower"
                              Stretch="Uniform"
                              Width="18"
                              Height="18"
                              Fill="{DynamicResource SystemFillColorSuccessBrush}"
                              Data="M11,2h2v10h-2z M12.5,4.05c3.84,0.31,6.97,3.44,7.28,7.28c0.39,4.86-3.44,8.96-8.28,8.96c-4.42,0-8-3.58-8-8c0-3.66,2.46-6.75,5.85-7.7L9.9,6.5c-2.34,0.73-4.05,2.91-4.05,5.5c0,3.31,2.69,6,6,6s6-2.69,6-6c0-2.59-1.71-4.77-4.05-5.5L12.5,4.05z"/>
                    </Button>
                </Grid>

                <Border x:Name="CodecCard"
                        Grid.Row="1"
                        Style="{StaticResource SettingsCard}"
                        Padding="14"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image x:Name="ImgCodecBadge"
                               Width="58"
                               Height="58"
                               Stretch="Uniform"
                               VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock x:Name="TxtCodecName"
                                       Text="Dolby Atmos"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border x:Name="BadgeChannel"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Padding="7,3"
                                        Margin="0,0,6,0">
                                    <TextBlock x:Name="TxtChannel" Text="7.1 ch" FontSize="12"/>
                                </Border>
                                <Border Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                        CornerRadius="4"
                                        Padding="7,3">
                                    <TextBlock x:Name="TxtInput"
                                               Text="HDMI"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="12"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="AuthRequiredCard"
                        Grid.Row="1"
                        Style="{StaticResource SettingsCard}"
                        Padding="14"
                        Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                CornerRadius="8"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE72E;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Sony account sign-in required"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Sign in again to reconnect and control your soundbar."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,9"/>
                            <Button x:Name="BtnAuthenticate"
                                    Content="Sign in"
                                    Style="{StaticResource AccentButton}"
                                    HorizontalAlignment="Left"
                                    Padding="14,5"
                                    Click="BtnAuthenticate_Click"
                                    AutomationProperties.Name="Sign in to Sony account"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ToggleButton x:Name="BtnNightMode"
                                  Grid.Column="0"
                                  Style="{StaticResource ActionTile}"
                                  Click="BtnNightMode_Click"
                                  AutomationProperties.Name="Night mode">
                        <StackPanel>
                            <Path Width="20" Height="20" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  Data="M15.6,2.2A9,9 0 1 0 21.8,14.4A7.2,7.2 0 0 1 15.6,2.2Z"/>
                            <TextBlock Text="Night mode" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock x:Name="TxtNightModeStatus" Text="Off" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="BtnSoundField"
                                  Grid.Column="2"
                                  Style="{StaticResource ActionTile}"
                                  Click="BtnSoundField_Click"
                                  AutomationProperties.Name="Sound field">
                        <StackPanel>
                            <Path Width="22" Height="20" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  Data="M3,9H6L10,5V19L6,15H3Z M13,8C14.8,10.2 14.8,13.8 13,16L15,17.5C17.7,14.3 17.7,9.7 15,6.5Z M17,4C21.6,8.4 21.6,15.6 17,20L19,22C24.7,16.5 24.7,7.5 19,2Z"/>
                            <TextBlock Text="Sound field" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock x:Name="TxtSoundFieldStatus" Text="On" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="BtnVoiceMode"
                                  Grid.Column="4"
                                  Style="{StaticResource ActionTile}"
                                  Click="BtnVoiceMode_Click"
                                  AutomationProperties.Name="Voice mode">
                        <StackPanel>
                            <Path Width="18" Height="21" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  Data="M12,2A4,4 0 0 0 8,6V12A4,4 0 0 0 16,12V6A4,4 0 0 0 12,2Z M5,11V12A7,7 0 0 0 11,18.9V22H13V18.9A7,7 0 0 0 19,12V11H17V12A5,5 0 0 1 7,12V11Z"/>
                            <TextBlock Text="Voice mode" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock x:Name="TxtVoiceModeStatus" Text="Off" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                </Grid>

                <Border Grid.Row="3"
                        Style="{StaticResource SettingsCard}"
                        Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="2,0,2,6">
                            <TextBlock Text="Volume" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="6"
                                    Padding="9,3"
                                    HorizontalAlignment="Right">
                                <TextBlock x:Name="TxtVolumeValue" Text="61" FontWeight="SemiBold" FontSize="13"/>
                            </Border>
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,10" MouseWheel="BorderVolume_MouseWheel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnSliderMute"
                                    Grid.Column="0"
                                    Style="{StaticResource IconButton}"
                                    Margin="0,0,8,0"
                                    Click="BtnSliderMute_Click"
                                    AutomationProperties.Name="Mute or unmute">
                                <Path x:Name="IconSpeaker"
                                      Stretch="Uniform"
                                      Width="18"
                                      Height="18"
                                      Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                      Data="M2,8v8h4l6,5V3L6,8H2z M16.5,8c.9,1.1 1.5,2.5 1.5,4s-.6,2.9-1.5,4l-1.5-1.5c.6-.7 1-1.6 1-2.5s-.4-1.8-1-2.5L16.5,8z M19,5.5c1.9,1.7 3,4 3,6.5s-1.1,4.8-3,6.5l-1.5-1.5c1.5-1.3 2.5-3.1 2.5-5s-1-3.7-2.5-5L19,5.5z"/>
                            </Button>

                            <Slider x:Name="SliderVolume"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="100"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    IsMoveToPointEnabled="True"
                                    ValueChanged="SliderVolume_ValueChanged"
                                    AutomationProperties.Name="Volume"/>
                        </Grid>

                        <DockPanel Grid.Row="2" Margin="2,0">
                            <TextBlock Text="Bass level"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="2"
                                    HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnBassMin" Content="MIN" Style="{StaticResource SegmentButton}" Click="BtnBassMin_Click"/>
                                    <Button x:Name="BtnBassMid" Content="MID" Style="{StaticResource SegmentButton}" Click="BtnBassMid_Click"/>
                                    <Button x:Name="BtnBassMax" Content="MAX" Style="{StaticResource SegmentButton}" Click="BtnBassMax_Click"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <Grid x:Name="PanelRearSpeaker" Grid.Row="3" Margin="2,12,2,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Rear speaker level"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"/>
                                <TextBlock x:Name="TxtRearValue"
                                           Text="0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider x:Name="SliderRear"
                                    Grid.Row="1"
                                    Minimum="{x:Static models:BraviaControlRanges.MinimumRearLevel}"
                                    Maximum="{x:Static models:BraviaControlRanges.MaximumRearLevel}"
                                    SmallChange="{x:Static models:BraviaControlRanges.RearLevelStep}"
                                    LargeChange="2"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="SliderRear_ValueChanged"
                                    AutomationProperties.Name="Rear speaker level"/>
                        </Grid>
                    </Grid>
                </Border>
              </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
