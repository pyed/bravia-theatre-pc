<Window x:Class="BraviaTheatre.UI.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BRAVIA Theatre PC"
        Width="350" Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Windows 11 Fluent Sound Slider Style matching native quick settings -->
        <Style x:Key="FluentSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="22">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="4.5" CornerRadius="2.25,0,0,2.25" Background="#4CC2FF"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="4.5" CornerRadius="0,2.25,2.25,0" Background="#8A8A8A"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="22" Height="22">
                                                    <!-- Outer Translucent Dark Halo -->
                                                    <Ellipse x:Name="OuterHalo" Width="20" Height="20" Fill="#444444" Opacity="0.85"/>
                                                    <!-- Inner Solid Fluent Blue Core -->
                                                    <Ellipse x:Name="InnerCore" Width="12" Height="12" Fill="#4CC2FF"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="OuterHalo" Property="Fill" Value="#555555"/>
                                                        <Setter TargetName="InnerCore" Property="Fill" Value="#6CD4FF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="OuterHalo" Property="Fill" Value="#333333"/>
                                                        <Setter TargetName="InnerCore" Property="Fill" Value="#38AEE6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bass Pill Segment Button Style -->
        <Style x:Key="BassSegmentBtn" TargetType="Button">
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="segBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="6,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="segBorder" Property="Background" Value="#2E2E2E"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat Icon Button Style -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="iconBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="iconBorder" Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="iconBorder" Property="Background" Value="#222222"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Action Tile Button Style -->
        <Style x:Key="ActionTile" TargetType="Button">
            <Setter Property="Height" Value="66"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="10,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#343434"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#484848"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#222222"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container with Windows 11 Rounded Drop Shadow Frame -->
    <Border CornerRadius="12" Background="#1F1F1F" BorderBrush="#383838" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <!-- Top Header -->
                <RowDefinition Height="Auto"/>
                <!-- Hero Codec Card -->
                <RowDefinition Height="Auto"/>
                <!-- Volume & Bass Section -->
                <RowDefinition Height="Auto"/>
                <!-- Action Tiles -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock x:Name="TxtDeviceName" Text="BRAVIA Theatre Bar 9" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                <Border x:Name="BadgeConnection" Background="#264d26" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                    <TextBlock x:Name="TxtConnection" Text="Connected" Foreground="#44d644" FontSize="11" FontWeight="Medium"/>
                </Border>
            </DockPanel>

            <!-- Hero Codec Card -->
            <Border Grid.Row="1" Background="#262626" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image x:Name="ImgCodecBadge" Width="54" Height="54" Stretch="Uniform" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="TxtCodecName" Text="Dolby Atmos" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border x:Name="BadgeChannel" Background="#383838" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock x:Name="TxtChannel" Text="7.1 ch" Foreground="#D0D0D0" FontSize="11" FontWeight="Medium"/>
                            </Border>
                            <Border Background="#2F2F2F" CornerRadius="4" Padding="6,2">
                                <TextBlock x:Name="TxtInput" Text="eARC / HDMI" Foreground="#A0A0A0" FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Volume & Bass Section with Fluent Track and Mouse Wheel -->
            <Border Grid.Row="2" Background="#262626" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14" MouseWheel="BorderVolume_MouseWheel">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Volume Title & Value Badge -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="Volume" Foreground="#D0D0D0" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                        <Border Background="#333333" CornerRadius="6" Padding="8,2" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtVolumeValue" Text="61" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                        </Border>
                    </DockPanel>

                    <!-- Row 1: Speaker Icon + Slider (Matching Windows 11 Native Sound Bar) -->
                    <Grid Grid.Row="1" Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Speaker / Mute Icon Button -->
                        <Button x:Name="BtnSliderMute" Grid.Column="0" Width="26" Height="26" Margin="0,0,8,0" Style="{StaticResource IconButton}" Click="BtnMute_Click">
                            <Path x:Name="IconSpeaker" Stretch="Uniform" Width="14" Height="14" Fill="#D0D0D0"
                                  Data="M3,9v6h4l5,5V4L7,9H3z M16.5,12c0-1.77-1.02-3.29-2.5-4.03v8.05C15.48,15.29,16.5,13.77,16.5,12z M14,3.23v2.06c2.89,0.86,5,3.54,5,6.71s-2.11,5.85-5,6.71v2.06c4.01-0.91,7-4.49,7-8.77S18.01,4.14,14,3.23z"/>
                        </Button>

                        <Slider x:Name="SliderVolume" Grid.Column="1" Style="{StaticResource FluentSlider}" Value="61" ValueChanged="SliderVolume_ValueChanged"/>
                    </Grid>

                    <!-- Row 2: Compact Bass Level Selector -->
                    <DockPanel Grid.Row="2" Margin="0,2,0,0">
                        <TextBlock Text="Bass Level" Foreground="#888888" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                        <Border Background="#1C1C1C" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" Padding="2" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnBassMin" Content="MIN" Style="{StaticResource BassSegmentBtn}" Click="BtnBassMin_Click"/>
                                <Button x:Name="BtnBassMid" Content="MID" Style="{StaticResource BassSegmentBtn}" Click="BtnBassMid_Click"/>
                                <Button x:Name="BtnBassMax" Content="MAX" Style="{StaticResource BassSegmentBtn}" Click="BtnBassMax_Click"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- 2x2 Quick Action Tiles Grid -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sound Field -->
                <Button x:Name="BtnSoundField" Grid.Row="0" Grid.Column="0" Style="{StaticResource ActionTile}" Margin="0,0,4,4" Click="BtnSoundField_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Sound Field" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtSoundFieldStatus" Text="On" FontSize="11" Foreground="#4CC2FF" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Night Mode -->
                <Button x:Name="BtnNightMode" Grid.Row="0" Grid.Column="1" Style="{StaticResource ActionTile}" Margin="4,0,0,4" Click="BtnNightMode_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Night Mode" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtNightModeStatus" Text="Off" FontSize="11" Foreground="#888888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Mute -->
                <Button x:Name="BtnMute" Grid.Row="1" Grid.Column="0" Style="{StaticResource ActionTile}" Margin="0,4,4,0" Click="BtnMute_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Mute" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtMuteStatus" Text="Unmuted" FontSize="11" Foreground="#888888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Power -->
                <Button x:Name="BtnPower" Grid.Row="1" Grid.Column="1" Style="{StaticResource ActionTile}" Margin="4,4,0,0" Click="BtnPower_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Power" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtPowerStatus" Text="On" FontSize="11" Foreground="#44d644" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
