<Window x:Class="BraviaTheatre.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - BRAVIA Theatre PC"
        Width="480" Height="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="HotkeyBox" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="Foreground" Value="#4CC2FF"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="ToolTip" Value="Click and press your desired shortcut key combination"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="tb" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="tb" Property="BorderBrush" Value="#4CC2FF"/>
                                <Setter TargetName="tb" Property="Background" Value="#252525"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="#1E1E1E" BorderBrush="#383838" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Content ScrollViewer -->
                <RowDefinition Height="*"/>
                <!-- Action Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Settings" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                <Button x:Name="BtnCloseHeader" Content="✕" Width="28" Height="28" HorizontalAlignment="Right" Background="Transparent" Foreground="#A0A0A0" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#333333"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </DockPanel>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                <StackPanel>
                    <!-- System & Startup Section -->
                    <TextBlock Text="GENERAL" Foreground="#4CC2FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Border Background="#262626" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox x:Name="ChkStartWithWindows" Content="Start automatically with Windows" Foreground="#D0D0D0" FontSize="12.5" Margin="0,4"/>
                            <CheckBox x:Name="ChkAlwaysShowOnTaskbar" Content="Always show icon on taskbar (prevent overflow hide)" Foreground="#D0D0D0" FontSize="12.5" Margin="0,8,0,4"/>
                            <CheckBox x:Name="ChkShowRearSpeaker" Content="Show Rear Speaker Level control (for SA-RS3S / SA-RS5)" Foreground="#D0D0D0" FontSize="12.5" Margin="0,8,0,4"/>
                        </StackPanel>
                    </Border>

                    <!-- Global Hotkeys Section -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="GLOBAL KEYBOARD SHORTCUTS" Foreground="#4CC2FF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="Reset to Defaults" HorizontalAlignment="Right" Padding="8,2" FontSize="10.5" Background="#2C2C2C" Foreground="#A0A0A0" BorderBrush="#383838" BorderThickness="1" Cursor="Hand" Click="BtnResetHotkeys_Click"/>
                    </DockPanel>

                    <Border Background="#262626" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox x:Name="ChkEnableGlobalHotkeys" Content="Enable global hotkeys" Foreground="#FFFFFF" FontWeight="Medium" FontSize="12.5" Margin="0,0,0,12"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Volume Up" Foreground="#D0D0D0" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox x:Name="TxtHotkeyVolUp" Grid.Row="0" Grid.Column="1" Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Volume Down" Foreground="#D0D0D0" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox x:Name="TxtHotkeyVolDown" Grid.Row="1" Grid.Column="1" Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Toggle Mute" Foreground="#D0D0D0" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox x:Name="TxtHotkeyMute" Grid.Row="2" Grid.Column="1" Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Toggle Sound Field" Foreground="#D0D0D0" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox x:Name="TxtHotkeySoundField" Grid.Row="3" Grid.Column="1" Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Toggle Voice Mode" Foreground="#D0D0D0" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox x:Name="TxtHotkeyVoiceMode" Grid.Row="4" Grid.Column="1" Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Toggle Night Mode" Foreground="#D0D0D0" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox x:Name="TxtHotkeyNightMode" Grid.Row="5" Grid.Column="1" Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Logging & Diagnostics -->
                    <TextBlock Text="LOGGING &amp; DIAGNOSTICS" Foreground="#4CC2FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Border Background="#262626" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Logging Level" Foreground="#FFFFFF" FontSize="12.5" FontWeight="Medium"/>
                                    <TextBlock Text="Critical logs errors only; Verbose logs all streams" Foreground="#888888" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="CboLogLevel" Width="120" Height="26" HorizontalAlignment="Right" Background="#1C1C1C" Foreground="#FFFFFF">
                                    <ComboBoxItem Content="Critical" Tag="Critical" ToolTip="Only fatal errors and crashes (Default - Minimal)"/>
                                    <ComboBoxItem Content="Info" Tag="Info" ToolTip="Startup, connection milestones, and errors"/>
                                    <ComboBoxItem Content="Verbose" Tag="Verbose" ToolTip="Full packet streams and diagnostic details"/>
                                </ComboBox>
                            </DockPanel>

                            <DockPanel Margin="0,4,0,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Log File Location" Foreground="#FFFFFF" FontSize="12.5" FontWeight="Medium"/>
                                    <TextBlock x:Name="TxtLogPath" Text="%APPDATA%\BraviaTheatrePC\bravia_csharp.log" Foreground="#888888" FontSize="10.5" Margin="0,2,0,0" FontFamily="Consolas, Segoe UI"/>
                                </StackPanel>
                                <Button Content="Open Folder" HorizontalAlignment="Right" Padding="10,4" Background="#333333" Foreground="#FFFFFF" BorderBrush="#444444" BorderThickness="1" Cursor="Hand" Click="BtnOpenLogFolder_Click"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Account & Authentication -->
                    <TextBlock Text="SONY ACCOUNT" Foreground="#4CC2FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Border Background="#262626" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <DockPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Account Credentials" Foreground="#FFFFFF" FontSize="12.5" FontWeight="Medium"/>
                                <TextBlock Text="Re-authenticate or pair a new device" Foreground="#888888" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Content="Re-authenticate" HorizontalAlignment="Right" Padding="12,6" Background="#333333" Foreground="#FFFFFF" BorderBrush="#444444" BorderThickness="1" Cursor="Hand" Click="BtnReAuth_Click"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="80" Height="32" Background="#2C2C2C" Foreground="#D0D0D0" BorderBrush="#3C3C3C" BorderThickness="1" Margin="0,0,8,0" Cursor="Hand" Click="BtnCancel_Click"/>
                <Button Content="Save" Width="80" Height="32" Background="#4CC2FF" Foreground="#000000" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
