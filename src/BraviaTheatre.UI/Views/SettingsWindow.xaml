<Window x:Class="BraviaTheatre.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — BRAVIA Theatre PC"
        Width="540"
        Height="720"
        MinWidth="500"
        MinHeight="560"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Background="Transparent"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>

        <Style x:Key="HotkeyBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="174"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="ToolTip" Value="Select and press the shortcut you want to use"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtAppVersion"
                           Text="BRAVIA Theatre PC"
                           Style="{StaticResource CaptionText}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,20">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="General" Style="{StaticResource SectionHeading}"/>
                    <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,20">
                        <StackPanel>
                            <CheckBox x:Name="ChkStartWithWindows"
                                      Content="Start automatically with Windows"
                                      Margin="0,2,0,10"/>
                            <CheckBox x:Name="ChkShowRearSpeaker"
                                      Content="Show rear speaker level control (SA-RS3S / SA-RS5)"
                                      Margin="0,0,0,12"/>

                            <Separator Margin="0,2,0,12"/>

                            <DockPanel LastChildFill="True" Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right"
                                        Content="Taskbar settings"
                                        Padding="12,5"
                                        Margin="14,0,0,0"
                                        Click="BtnOpenTaskbarSettings_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Keep the tray icon visible" FontWeight="SemiBold"/>
                                    <TextBlock Text="Windows controls this placement under Other system tray icons."
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <Separator Margin="0,0,0,12"/>

                            <TextBlock Text="Connection override" FontWeight="SemiBold"/>
                            <TextBlock Text="Leave host empty for automatic discovery. Saving a change reconnects the controller."
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,3,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtStaticHost"
                                         Grid.Column="0"
                                         Height="32"
                                         Margin="0,0,8,0"
                                         Padding="8,2"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Optional soundbar hostname or IP address"
                                         AutomationProperties.Name="Static soundbar host"/>
                                <TextBox x:Name="TxtStaticPort"
                                         Grid.Column="1"
                                         Height="32"
                                         Padding="8,2"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Connection port"
                                         AutomationProperties.Name="Soundbar port"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <DockPanel Margin="2,0,0,8">
                        <Button DockPanel.Dock="Right"
                                Content="Reset defaults"
                                Padding="10,4"
                                Click="BtnResetHotkeys_Click"/>
                        <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SectionHeading}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,20">
                        <StackPanel>
                            <CheckBox x:Name="ChkEnableGlobalHotkeys"
                                      Content="Enable global hotkeys"
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Volume up" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtHotkeyVolUp" Grid.Row="0" Grid.Column="1"
                                         Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         AutomationProperties.Name="Volume up shortcut"/>
                                <TextBlock Grid.Row="1" Text="Volume down" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtHotkeyVolDown" Grid.Row="1" Grid.Column="1"
                                         Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         AutomationProperties.Name="Volume down shortcut"/>
                                <TextBlock Grid.Row="2" Text="Toggle mute" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtHotkeyMute" Grid.Row="2" Grid.Column="1"
                                         Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         AutomationProperties.Name="Toggle mute shortcut"/>
                                <TextBlock Grid.Row="3" Text="Toggle sound field" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtHotkeySoundField" Grid.Row="3" Grid.Column="1"
                                         Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         AutomationProperties.Name="Toggle sound field shortcut"/>
                                <TextBlock Grid.Row="4" Text="Toggle voice mode" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtHotkeyVoiceMode" Grid.Row="4" Grid.Column="1"
                                         Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         AutomationProperties.Name="Toggle voice mode shortcut"/>
                                <TextBlock Grid.Row="5" Text="Toggle night mode" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtHotkeyNightMode" Grid.Row="5" Grid.Column="1"
                                         Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         AutomationProperties.Name="Toggle night mode shortcut"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Logging and diagnostics" Style="{StaticResource SectionHeading}"/>
                    <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,20">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <ComboBox x:Name="CboLogLevel" DockPanel.Dock="Right"
                                          Width="132" Height="32" Margin="14,0,0,0"
                                          AutomationProperties.Name="Logging level">
                                    <ComboBoxItem Content="Critical" Tag="Critical" ToolTip="Only errors and crashes"/>
                                    <ComboBoxItem Content="Info" Tag="Info" ToolTip="Connection milestones and errors"/>
                                    <ComboBoxItem Content="Verbose" Tag="Verbose" ToolTip="Full diagnostic details"/>
                                </ComboBox>
                                <StackPanel>
                                    <TextBlock Text="Logging level" FontWeight="SemiBold"/>
                                    <TextBlock Text="Critical keeps routine logging minimal."
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <Separator Margin="0,0,0,12"/>

                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="Open folder"
                                        Padding="12,5"
                                        Margin="14,0,0,0"
                                        Click="BtnOpenLogFolder_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Log file" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtLogPath"
                                               Text="%LOCALAPPDATA%\BraviaTheatrePC\bravia_csharp.log"
                                               Style="{StaticResource CaptionText}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="10.5"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Sony account" Style="{StaticResource SectionHeading}"/>
                    <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,20">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="Re-authenticate"
                                    Padding="12,5"
                                    Margin="14,0,0,0"
                                    Click="BtnReAuth_Click"/>
                            <StackPanel>
                                <TextBlock Text="Account credentials" FontWeight="SemiBold"/>
                                <TextBlock Text="Sign in again or pair another compatible device."
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="About" Style="{StaticResource SectionHeading}"/>
                    <Border Style="{StaticResource SettingsCard}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="GitHub releases"
                                    Padding="12,5"
                                    Margin="14,0,0,0"
                                    Click="BtnCheckUpdates_Click"/>
                            <StackPanel>
                                <TextBlock Text="Updates and source code" FontWeight="SemiBold"/>
                                <TextBlock Text="Review releases and project information on GitHub."
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        IsCancel="True"
                        MinWidth="88"
                        Height="34"
                        Margin="0,0,8,0"
                        Click="BtnCancel_Click"/>
                <Button Content="Save"
                        IsDefault="True"
                        MinWidth="88"
                        Height="34"
                        Style="{StaticResource AccentButton}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
