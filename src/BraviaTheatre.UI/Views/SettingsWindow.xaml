<Window x:Class="BraviaTheatre.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - BRAVIA Theatre PC"
        Width="440" Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Border CornerRadius="12" Background="#1E1E1E" BorderBrush="#383838" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Content ScrollViewer -->
                <RowDefinition Height="*"/>
                <!-- Action Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Settings" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                <Button x:Name="BtnCloseHeader" Content="✕" Width="28" Height="28" HorizontalAlignment="Right" Background="Transparent" Foreground="#A0A0A0" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#333333"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </DockPanel>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                <StackPanel>
                    <!-- System & Startup Section -->
                    <TextBlock Text="GENERAL" Foreground="#4CC2FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Border Background="#262626" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox x:Name="ChkStartWithWindows" Content="Start automatically with Windows" Foreground="#D0D0D0" FontSize="12.5" Margin="0,4"/>
                            <CheckBox x:Name="ChkAlwaysShowOnTaskbar" Content="Always show icon on taskbar (prevent overflow hide)" Foreground="#D0D0D0" FontSize="12.5" Margin="0,8,0,4"/>
                            <CheckBox x:Name="ChkShowRearSpeaker" Content="Show Rear Speaker Level control" Foreground="#D0D0D0" FontSize="12.5" Margin="0,8,0,4"/>
                        </StackPanel>
                    </Border>

                    <!-- Global Hotkeys Section -->
                    <TextBlock Text="GLOBAL KEYBOARD SHORTCUTS" Foreground="#4CC2FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Border Background="#262626" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox x:Name="ChkEnableGlobalHotkeys" Content="Enable global hotkeys" Foreground="#FFFFFF" FontWeight="Medium" FontSize="12.5" Margin="0,0,0,10"/>
                            
                            <Grid Margin="4,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="22"/>
                                    <RowDefinition Height="22"/>
                                    <RowDefinition Height="22"/>
                                    <RowDefinition Height="22"/>
                                    <RowDefinition Height="22"/>
                                    <RowDefinition Height="22"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Win + Alt + Up" Foreground="#4CC2FF" FontFamily="Consolas" FontSize="11.5"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Volume Up (+2)" Foreground="#A0A0A0" FontSize="11.5"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Win + Alt + Down" Foreground="#4CC2FF" FontFamily="Consolas" FontSize="11.5"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Volume Down (-2)" Foreground="#A0A0A0" FontSize="11.5"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Win + Alt + M" Foreground="#4CC2FF" FontFamily="Consolas" FontSize="11.5"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Toggle Mute" Foreground="#A0A0A0" FontSize="11.5"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Win + Alt + S" Foreground="#4CC2FF" FontFamily="Consolas" FontSize="11.5"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Toggle Sound Field" Foreground="#A0A0A0" FontSize="11.5"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Win + Alt + V" Foreground="#4CC2FF" FontFamily="Consolas" FontSize="11.5"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Toggle Voice Mode" Foreground="#A0A0A0" FontSize="11.5"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Win + Alt + N" Foreground="#4CC2FF" FontFamily="Consolas" FontSize="11.5"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="Toggle Night Mode" Foreground="#A0A0A0" FontSize="11.5"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Account & Authentication -->
                    <TextBlock Text="SONY ACCOUNT" Foreground="#4CC2FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Border Background="#262626" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <DockPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Account Credentials" Foreground="#FFFFFF" FontSize="12.5" FontWeight="Medium"/>
                                <TextBlock Text="Re-authenticate or pair a new device" Foreground="#888888" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Content="Re-authenticate" HorizontalAlignment="Right" Padding="12,6" Background="#333333" Foreground="#FFFFFF" BorderBrush="#444444" BorderThickness="1" Cursor="Hand" Click="BtnReAuth_Click"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="80" Height="32" Background="#2C2C2C" Foreground="#D0D0D0" BorderBrush="#3C3C3C" BorderThickness="1" Margin="0,0,8,0" Cursor="Hand" Click="BtnCancel_Click"/>
                <Button Content="Save" Width="80" Height="32" Background="#4CC2FF" Foreground="#000000" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
