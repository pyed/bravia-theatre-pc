<Window x:Class="BraviaTheatre.UI.Views.AuthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sony account sign-in — BRAVIA Theatre PC"
        ThemeMode="System"
        Width="600"
        Height="740"
        MinWidth="520"
        MinHeight="620"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Background="Transparent"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded">

    <Border Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Sony account sign-in" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtSubtitle"
                           Text="Sign in with your Sony account to connect your BRAVIA Theatre system"
                           Style="{StaticResource CaptionText}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid x:Name="PanelAutoMode">
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <wv2:WebView2 x:Name="AuthWebView"/>
                    </Border>

                    <Border x:Name="OverlayProgress"
                            Background="{DynamicResource SmokeFillColorDefaultBrush}"
                            CornerRadius="8"
                            Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                            <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,18"/>
                            <TextBlock x:Name="TxtProgressStatus"
                                       Text="Loading Sony sign-in…"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       TextAlignment="Center"/>
                            <TextBlock Text="Sign in to your Sony BRAVIA Connect account"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="PanelManualMode" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCard}" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Manual authentication"
                                               FontWeight="SemiBold"
                                               FontSize="18"
                                               Margin="0,0,0,10"/>
                                    <TextBlock Text="Use this fallback only if the automatic sign-in view is unavailable."
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,0,0,14"/>
                                    <TextBlock Text="1. Open Sony sign-in in your browser." Margin="0,3" TextWrapping="Wrap"/>
                                    <TextBlock Text="2. Open Developer Tools (F12), select Network, and enable Preserve log." Margin="0,3" TextWrapping="Wrap"/>
                                    <TextBlock Text="3. Sign in, filter requests for ssh, and copy the redirect beginning ssh-app://signin?code=." Margin="0,3" TextWrapping="Wrap"/>
                                    <TextBlock Text="4. Paste the complete callback URL below, then select Complete and connect." Margin="0,3" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="1">
                                <Button x:Name="BtnOpenBrowser"
                                        Content="Open Sony sign-in in browser"
                                        Height="34"
                                        Click="BtnOpenBrowser_Click"
                                        Margin="0,0,0,12"/>
                                <TextBlock Text="Complete ssh-app:// callback URL"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtAuthCode"
                                         Height="34"
                                         Padding="8,2"
                                         VerticalContentAlignment="Center"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="11"
                                         AutomationProperties.Name="Sony callback URL"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnToggleMode"
                        Content="Switch to manual mode (F12)"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Padding="8,5"
                        Click="BtnToggleMode_Click"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnCancel"
                            Content="Cancel"
                            IsCancel="True"
                            MinWidth="86"
                            Height="34"
                            Margin="0,0,8,0"
                            Click="BtnCancel_Click"/>
                    <Button x:Name="BtnManualComplete"
                            Content="Complete and connect"
                            IsDefault="True"
                            MinWidth="150"
                            Height="34"
                            Style="{StaticResource AccentButton}"
                            Visibility="Collapsed"
                            Click="BtnComplete_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
