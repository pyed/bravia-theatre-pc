<Window x:Class="BraviaTheatre.UI.Views.AuthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sony Account Authentication"
        Width="520" Height="500"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#FFFFFF"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Sony Account Setup" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Text="Authenticate with your Sony account to enable local encrypted control of your BRAVIA Theatre system." Foreground="#B0B0B0" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16"/>

        <!-- Step-by-Step Instructions Card -->
        <Border Grid.Row="2" Background="#262626" BorderBrush="#383838" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Step 1: Open Sony Sign-In" FontWeight="SemiBold" FontSize="13" Foreground="#0078D7" Margin="0,0,0,4"/>
                    <TextBlock Text="Click the button below to open Sony's official login page in your default browser." Foreground="#C0C0C0" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"/>

                    <TextBlock Text="Step 2: Capture the Authorization Code" FontWeight="SemiBold" FontSize="13" Foreground="#0078D7" Margin="0,0,0,4"/>
                    <TextBlock Text="1. In your browser, press F12 (or right-click -> Inspect) to open Developer Tools." Foreground="#C0C0C0" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,2"/>
                    <TextBlock Text="2. Go to the Network tab and check the 'Preserve log' checkbox." Foreground="#C0C0C0" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,2"/>
                    <TextBlock Text="3. Log in with your Sony account credentials." Foreground="#C0C0C0" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,2"/>
                    <TextBlock Text="4. Filter the network requests with the keyword 'ssh' or 'signin'." Foreground="#C0C0C0" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,2"/>
                    <TextBlock Text="5. Copy the full redirect URL (starting with ssh-app://signin?code=...)." Foreground="#C0C0C0" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"/>

                    <TextBlock Text="Step 3: Paste Code Below" FontWeight="SemiBold" FontSize="13" Foreground="#0078D7" Margin="0,0,0,4"/>
                    <TextBlock Text="Paste the copied link or authorization code into the field below and click Connect." Foreground="#C0C0C0" TextWrapping="Wrap" FontSize="11"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Browser Button & Input Field -->
        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <Button x:Name="BtnOpenBrowser" Content="Open Sony Sign-In in Browser" Height="36" Background="#0078D7" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnOpenBrowser_Click" Margin="0,0,0,10">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <TextBlock Text="Authorization Code / Redirect URL:" FontSize="12" Foreground="#D0D0D0" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtAuthCode" Height="32" Background="#161616" Foreground="#FFFFFF" BorderBrush="#444444" BorderThickness="1" Padding="8,4" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Footer Buttons -->
        <DockPanel Grid.Row="4">
            <Button x:Name="BtnCancel" Content="Cancel" Width="80" Height="32" Background="#333333" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click" HorizontalAlignment="Left">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button x:Name="BtnComplete" Content="Complete &amp; Connect" Width="140" Height="32" Background="#267326" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnComplete_Click" HorizontalAlignment="Right">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </DockPanel>
    </Grid>
</Window>
